# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local-only MCP server config — contains Supabase personal access token.
.mcp.json

# Claude Code local state (session locks, personal settings).
.claude/

# Local warehouse-agent queue spillover (offline scan retry buffer).
warehouse-agent/data/pending-scans.jsonl

# Local warehouse-agent recording output — MP4 segments from real cameras.
# Sensitive footage; must never be pushed to git.
warehouse-agent/recordings/

# Local installed/bundled agent copy and generated MediaMTX TLS material.
/BetacomAgent/
/warehouse-agent/auto.crt
/warehouse-agent/auto.key

# One-off local database/debug scripts.
/scratch_*.mjs

# Scratch/temp slice files accidentally created in repo root.
*.tmp_slice*

# Supabase CLI cache (version pins, ephemeral state).
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ban sao du lieu production keo xuong local (scripts/copy-prod-to-local.sh).
# CHUA DU LIEU THAT cua khach — tuyet doi khong commit.
.tmp/
