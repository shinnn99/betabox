# /etc/systemd/system/betabox-orphan-segments.service
#
# Đóng row `camera_recording_files` mồ côi: ended_at NULL nhưng quá cũ
# để còn là segment đang ghi (agent chết giữa segment, không kịp ghi
# ended_at).
#
# Vì sao cần: 04/09/2026 một row mồ côi từ 27/08 ở kho Đại Kim đã chặn
# cắt clip cho 92 đơn liên tiếp trong 8 ngày. Resolver đã được vá để bỏ
# qua row loại này (src/lib/order-proof/open-segment-verdict.ts), nhưng
# dữ liệu sai vẫn cần dọn — mọi thống kê đọc bảng đó đều thấy số sai.
#
# Khuôn theo betabox-cleanup.service: không User=, không WorkingDirectory=
# (chỉ gọi curl). GET như cleanup-clips, khác với syscheck dùng POST.
#
# --max-time 300: job duyệt tối đa 500 row, mỗi row 1 SELECT + 1 UPDATE.
# Bình thường chạy dưới 1 giây vì hầu như không có row mồ côi nào.
#
# ⚠ THAY UUID DƯỚI ĐÂY bằng check MỚI trên healthchecks.io (chu kỳ 1
# ngày, grace 2 giờ). KHÔNG dùng lại UUID của cleanup hay syscheck: dùng
# chung thì job này chết mà check vẫn xanh nhờ job kia ping.

[Unit]
Description=Betabox đóng row segment mồ côi (ended_at NULL quá cũ)

[Service]
Type=oneshot
EnvironmentFile=/etc/betabox-cron.env
ExecStart=/usr/bin/curl -fsS --max-time 300 -H "Authorization: Bearer ${CRON_SECRET}" https://betabox.betacom.agency/api/cron/close-orphan-segments
ExecStartPost=/usr/bin/curl -fsS -m 10 https://hc-ping.com/THAY-BANG-UUID-ORPHAN-SEGMENTS-MOI
